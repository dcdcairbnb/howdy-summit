node_modules
.env
.env.local
.vercel
.DS_Store
.env*.local
DEPLOY.command
COMMIT_MSG.txt

# Generated by scripts/build-www.sh on every iOS sync. It is just a copy of
# index.html and the static assets, so committing it would double the repo
# and create pointless diffs. Rebuild with: npm run build:www
www/

# Xcode build artifacts and local user state. The ios/ project itself IS
# committed (it holds Info.plist, signing config, and the app icon), but
# these subpaths are machine-specific noise.
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/DerivedData/
ios/.sourcemaps
*.xcuserstate
DerivedData/
