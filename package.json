{
  "name": "howdy-summit",
  "version": "1.0.0",
  "description": "Howdy Summit: a free Summit County, Colorado tourist guide with AI concierge. Live data, ride and delivery deep links, no signup.",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "build:www": "bash scripts/build-www.sh",
    "ios:sync": "npm run build:www && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@upstash/redis": "^1.34.3",
    "pg": "^8.13.1",
    "resend": "^4.0.1"
  }
}
